{
  "name": "todo-teams",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "node --import tsx --test \"server/**/*.test.ts\"",
    "seed:sample": "node --import tsx server/ml/seed-sample.ts",
    "seed:purge": "node --import tsx server/ml/seed-sample.ts --purge"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "4.1.17",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.68.2",
    "tailwindcss": "4.1.17",
    "@tailwindcss/node": "4.1.17",
    "@tailwindcss/oxide": "4.1.17"
  }
}
